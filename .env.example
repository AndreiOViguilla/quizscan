# Copy this file to .env and fill in your keys

# Hugging Face API Key — get free at huggingface.co/settings/tokens
# Make sure the token has "Read" permissions (Inference API access)
REACT_APP_HF_KEY=hf_your_token_here

# Supabase — get from supabase.com project settings (optional, for multiplayer)
REACT_APP_SUPABASE_URL=your_supabase_url_here
REACT_APP_SUPABASE_KEY=your_supabase_anon_key_here
